<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for the Maple EXP shipper. install.sh replaces
     __HOME__ and __INSTALL_DIR__ with absolute paths before installing
     this into ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.warnerktsang.maple-shipper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__INSTALL_DIR__/shipper.py</string>
    <string>--config</string>
    <string>__INSTALL_DIR__/config.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/MapleShipper/shipper.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/MapleShipper/shipper.log</string>
</dict>
</plist>
