[Unit]
Description=Update Crowdset GPU worker from CI-approved main

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/crowdset-worker
ExecStart=/usr/bin/python3 %h/.local/share/crowdset-worker/gpu_updater.py --root %h/.local/share/crowdset-worker
TimeoutStartSec=3min
UMask=0077
NoNewPrivileges=true
