SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
CORS_EXTRA_ORIGINS=http://YOUR_VPS_IP
SITE_URL=http://YOUR_VPS_IP
READINESS_TIMEOUT_SECONDS=2

# Optional SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Beli app: Fernet key encrypting friends' Beli logins at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit the real value. Set it in Coolify env vars for production.
BELI_CREDENTIALS_KEY=

# Beli app: optional Instagram session so the @beli_eats watcher can pull posts
# from hosting IPs (best-effort without it; the job skips quietly when IG fails).
BELI_EATS_IG_USERNAME=
BELI_EATS_IG_PASSWORD=
